<!-- 横屏布局：抽屉和内容并排显示，背景延伸全屏 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".preferences.StreamSettings">

    <FrameLayout
        android:id="@+id/settings_layout_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 全屏背景图片 -->
        <ImageView
            android:id="@+id/settingsBackgroundImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <!-- 全屏半透明遮罩 -->
        <View
            android:id="@+id/settingsBackgroundOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/settings_background_overlay" />

        <!-- 内容层：菜单和设置并排 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- 左侧菜单（固定显示） -->
            <LinearLayout
                android:id="@+id/drawer_menu"
                android:layout_width="@dimen/settings_landscape_sidebar_width"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/settings_drawer_background_landscape"
                android:paddingTop="@dimen/activity_safearea_top"
                android:elevation="4dp">

                <!-- 返回贴左，品牌图标居中放大，避免返回单独占出一条空白 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center_horizontal"
                        app:cardCornerRadius="36dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#222222">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/vplus"
                            android:scaleType="centerCrop" />

                    </androidx.cardview.widget.CardView>

                    <ImageView
                        android:id="@+id/settings_back"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="@color/ui_shell_text_primary"
                        android:background="@drawable/menu_button_background_stylish"
                        android:scaleType="center"
                        android:padding="10dp"
                        android:contentDescription="@string/addpc_back" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/settings_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/settings_search_bar_background"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:id="@+id/settings_search_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:srcCompat="@drawable/ic_search_stylish"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/settings_search_hint" />

                    <EditText
                        android:id="@+id/settings_search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/settings_search_hint"
                        android:textColor="@color/ui_shell_text_primary"
                        android:textColorHint="@color/ui_shell_text_secondary"
                        android:textSize="13sp"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:importantForAutofill="no" />

                    <ImageView
                        android:id="@+id/settings_search_close"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_close_stylish"
                        android:scaleType="center"
                        android:padding="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/settings_search_clear" />

                </LinearLayout>

                <!-- 分类列表 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/category_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <!-- 版本号 -->
                <TextView
                    android:id="@+id/drawer_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:paddingBottom="12dp"
                    android:paddingTop="8dp"
                    android:textSize="10sp"
                    android:textColor="?attr/appAccent27"
                    android:letterSpacing="0.05"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- 右侧主内容区域 -->
            <RelativeLayout
                android:id="@+id/stream_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- 设置内容区域（横屏无顶部标题，直接顶到安全区） -->
                <FrameLayout
                    android:id="@+id/preference_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:paddingTop="@dimen/activity_safearea_top"/>

            </RelativeLayout>

        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/screen_combination_mode_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_combination_mode_picker_background"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
