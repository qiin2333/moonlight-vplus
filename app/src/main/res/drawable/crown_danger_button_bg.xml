<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_action_sheet_danger_soft" />
            <stroke android:width="1dp" android:color="@color/app_action_sheet_danger" />
            <corners android:radius="@dimen/corner_radius_medium" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_action_sheet_danger_soft" />
            <stroke android:width="1dp" android:color="@color/app_action_sheet_danger" />
            <corners android:radius="@dimen/corner_radius_medium" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_action_sheet_danger_soft" />
            <stroke android:width="1dp" android:color="@color/app_action_sheet_danger_border" />
            <corners android:radius="@dimen/corner_radius_medium" />
        </shape>
    </item>
</selector>
