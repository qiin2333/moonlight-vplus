<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- 梦幻渐变背景 - 柔和过渡 -->
    <gradient
        android:startColor="?attr/pcDecorIconBgStart"
        android:centerColor="?attr/pcDecorIconBgCenter"
        android:endColor="?attr/pcDecorIconBgEnd"
        android:angle="135"
        android:type="radial"
        android:centerX="0.5"
        android:centerY="0.5"
        android:gradientRadius="80dp" />
    <!-- 柔和边框 -->
    <stroke
        android:width="1dp"
        android:color="?attr/pcDecorIconBgStroke" />
</shape>
