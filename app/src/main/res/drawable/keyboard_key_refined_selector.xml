<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#555555" />
            <corners android:radius="@dimen/corner_radius_small" />
            <stroke android:width="1dp" android:color="#777777" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#4A303B" />
            <corners android:radius="@dimen/corner_radius_small" />
            <stroke android:width="2dp" android:color="@color/game_menu_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#333333" />
            <corners android:radius="@dimen/corner_radius_small" />
            <stroke android:width="1dp" android:color="#444444" />
        </shape>
    </item>
</selector>
