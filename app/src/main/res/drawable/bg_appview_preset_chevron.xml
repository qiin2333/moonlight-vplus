<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/appview_preset_active_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/appview_preset_active" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/appview_preset_chip_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/appview_preset_chip_stroke" />
        </shape>
    </item>
</selector>
