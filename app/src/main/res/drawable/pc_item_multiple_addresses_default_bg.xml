<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="20dp" android:left="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="-45"
                android:centerColor="?attr/pcDecorStackDefaultBackCenter"
                android:endColor="?attr/pcDecorStackDefaultBackEnd"
                android:startColor="?attr/pcDecorStackDefaultBackStart" />
            <corners android:radius="@dimen/corner_radius_medium" />
        </shape>
    </item>

    <item android:bottom="10dp" android:left="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="-45"
                android:centerColor="?attr/pcDecorStackDefaultMidCenter"
                android:endColor="?attr/pcDecorStackDefaultMidEnd"
                android:startColor="?attr/pcDecorStackDefaultMidStart" />
            <corners android:radius="@dimen/corner_radius_medium" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="-45"
                android:centerColor="?attr/pcDecorStackDefaultFrontCenter"
                android:endColor="?attr/pcDecorStackDefaultFrontEnd"
                android:startColor="?attr/pcDecorStackDefaultFrontStart" />
            <corners android:radius="@dimen/corner_radius_medium" />
        </shape>
    </item>
</layer-list>
