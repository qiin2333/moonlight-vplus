<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="5dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_dialog_surface_shadow" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/app_dialog_surface_gradient_start"
                android:centerColor="@color/app_dialog_surface_gradient_center"
                android:endColor="@color/app_dialog_surface_gradient_end" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/app_dialog_outline" />
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
            <stroke
                android:width="1dp"
                android:color="@color/app_dialog_surface_highlight" />
        </shape>
    </item>
</layer-list>

