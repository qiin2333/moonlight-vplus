<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/appAccent27" />
            <corners android:radius="@dimen/corner_radius_small" />
            <stroke android:width="1dp" android:color="?attr/appAccent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#664A303B" />
            <corners android:radius="@dimen/corner_radius_small" />
            <stroke android:width="2dp" android:color="?attr/appAccent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/appAccent27" />
            <corners android:radius="@dimen/corner_radius_small" />
            <stroke android:width="1dp" android:color="?attr/appAccent50" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#222222" />
            <corners android:radius="@dimen/corner_radius_small" />
            <stroke android:width="1dp" android:color="#333333" />
        </shape>
    </item>
</selector>
