<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="8dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/about_dialog_window_shadow" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/about_dialog_window_start"
                android:centerColor="@color/about_dialog_window_center"
                android:endColor="@color/about_dialog_window_end" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="@color/about_dialog_window_outline" />
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp" />
        </shape>
    </item>
</layer-list>
