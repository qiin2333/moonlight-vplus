<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/about_dialog_panel_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/about_dialog_panel_start"
                android:centerColor="@color/about_dialog_panel_center"
                android:endColor="@color/about_dialog_panel_end" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/about_dialog_panel_outline" />
        </shape>
    </item>
</layer-list>
