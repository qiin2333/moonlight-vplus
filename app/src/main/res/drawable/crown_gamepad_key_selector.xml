<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/appAccent20" />
            <stroke android:width="1dp" android:color="?attr/appAccent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/crown_button_focused" />
            <stroke android:width="2dp" android:color="?attr/appAccent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/appAccent27" />
            <stroke android:width="1dp" android:color="?attr/appAccent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/crown_input_background" />
            <stroke android:width="1dp" android:color="@color/crown_section_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
