<?xml version="1.0" encoding="utf-8"?>
<!-- 通用强调色按钮：原粉色渐变改为实心主题强调色（Material You 开启后跟随壁纸） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appAccent" />
            <corners android:radius="@dimen/corner_radius_medium" />
            <stroke android:width="1.5dp" android:color="?attr/appAccent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appAccent" />
            <corners android:radius="@dimen/corner_radius_medium" />
            <stroke android:width="1.5dp" android:color="@color/theme_blue_primary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appAccent" />
            <corners android:radius="@dimen/corner_radius_medium" />
            <stroke android:width="1.5dp" android:color="?attr/appAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/appAccent" />
            <corners android:radius="@dimen/corner_radius_medium" />
            <stroke android:width="1dp" android:color="?attr/appAccent" />
        </shape>
    </item>
</selector>
