            <!-- 第二层背景 (中间层) - 正上方偏移 - 中粉色 -->
            <item android:bottom="10dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/pc_item_stack_default_mid_start"
                        android:centerColor="@color/pc_item_stack_default_mid_center"
