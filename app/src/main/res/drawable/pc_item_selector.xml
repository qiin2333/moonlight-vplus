<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/pcDecorSurfacePressedStart"
                android:centerColor="?attr/pcDecorSurfacePressedCenter"
                android:endColor="?attr/pcDecorSurfacePressedEnd"
                android:angle="135" />
            <corners android:radius="@dimen/corner_radius_large"/>
            <stroke android:width="2dp" android:color="@color/pc_item_outline_focused"/>
        </shape>
    </item>
    
    <!-- 焦点 / 选中：与应用卡一致的亮蓝描边 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FF66C0F4" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FF66C0F4" />
        </shape>
    </item>

    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/pcDecorSurfaceDefaultStart"
                android:centerColor="?attr/pcDecorSurfaceDefaultCenter"
                android:endColor="?attr/pcDecorSurfaceDefaultEnd"
                android:angle="135" />
            <corners android:radius="@dimen/corner_radius_large"/>
        </shape>
    </item>
</selector>
