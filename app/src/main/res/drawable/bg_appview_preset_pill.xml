<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/appview_preset_pill_radius" />
            <solid android:color="@color/appview_panel_surface" />
            <stroke
                android:width="2dp"
                android:color="@color/ui_shell_accent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/appview_preset_pill_radius" />
            <solid android:color="@color/appview_panel_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/ui_shell_outline" />
        </shape>
    </item>
</selector>
