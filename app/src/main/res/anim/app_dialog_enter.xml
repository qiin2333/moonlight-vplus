<?xml version="1.0" encoding="utf-8"?>
<!-- Window transforms are composited without remeasuring the dialog content. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <scale
        android:duration="220"
        android:fromXScale="0.96" android:toXScale="1"
        android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%"
        android:interpolator="@interpolator/expressive_settle" />
    <alpha android:duration="100"
        android:fromAlpha="0" android:toAlpha="1"
        android:interpolator="@android:interpolator/linear" />
</set>
