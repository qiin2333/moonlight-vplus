<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:stateListAnimator="@animator/expressive_item_state"
    android:background="@drawable/pc_item_selector"
    android:clipChildren="true"
    android:clipToPadding="true">

    <!-- 透明的圆角轮廓，把封面裁成与卡片一致的圆角；留 2dp 让焦点描边露出来。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:background="@drawable/pc_grid_item_clip_bg"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/pc_icon_description"
            android:scaleType="centerCrop" />

        <!-- 底部压暗，保证主机名在封面上可读。 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="bottom"
            android:background="@drawable/steam_card_scrim"
            android:importantForAccessibility="no" />

        <!-- 旧版图标装饰保留 ID，但不再显示；封面本身就是主视觉。 -->
        <View
            android:id="@+id/pcIconGlow"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
        <View
            android:id="@+id/pcIconBg"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:contentDescription="@string/pc_status_description"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/grid_spinner"
            android:layout_width="48dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@string/loading_description"
            android:scaleType="fitCenter"
            android:src="@drawable/white_dots_animation" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/grid_text"
                style="@style/PcHostNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                tools:ignore="RtlHardcoded"
                tools:text="0x77-H" />

            <TextView
                android:id="@+id/grid_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#A9C2D2"
                android:textSize="13sp"
                tools:text="在线" />

            <LinearLayout
                android:id="@+id/grid_network_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/grid_network_quality_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/phc_perf_wifi"
                    app:tint="#8ED9FF" />

                <TextView
                    android:id="@+id/grid_network_quality_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#C7DCE8"
                    android:textSize="13sp"
                    tools:text="9 ms · 62 Mbps" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
