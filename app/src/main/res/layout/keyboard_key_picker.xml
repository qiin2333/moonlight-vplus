<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_drawing"
    style="@style/VirtualKeyboardStyle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="220dp"
    android:orientation="vertical">

    <include layout="@layout/keyboard_picker_tabs" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/keyboard_picker_main"
            layout="@layout/layout_keyboard_main" />

        <include
            android:id="@+id/keyboard_picker_nav"
            layout="@layout/layout_keyboard_nav"
            android:visibility="gone" />

        <include
            android:id="@+id/keyboard_picker_num"
            layout="@layout/layout_keyboard_numpad"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
