<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:background="@drawable/keyboard_opacity_popover_bg"
    android:elevation="18dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/keyboard_opacity_title"
        android:textColor="@color/crown_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
            android:id="@+id/keyboard_opacity_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="70"
            android:progress="70"
            android:progressBackgroundTint="@color/crown_input_background"
            android:progressTint="@color/crown_keyboard_single_border"
            android:thumbTint="@color/crown_keyboard_single_border" />

        <TextView
            android:id="@+id/keyboard_opacity_value"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="100%"
            android:textColor="@color/crown_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/keyboard_opacity_100"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/keyboard_opacity_preset_bg"
            android:gravity="center"
            android:text="100%"
            android:textColor="@color/keyboard_opacity_preset_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/keyboard_opacity_85"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/keyboard_opacity_preset_bg"
            android:gravity="center"
            android:text="85%"
            android:textColor="@color/keyboard_opacity_preset_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/keyboard_opacity_70"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/keyboard_opacity_preset_bg"
            android:gravity="center"
            android:text="70%"
            android:textColor="@color/keyboard_opacity_preset_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/keyboard_opacity_50"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/keyboard_opacity_preset_bg"
            android:gravity="center"
            android:text="50%"
            android:textColor="@color/keyboard_opacity_preset_text"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>