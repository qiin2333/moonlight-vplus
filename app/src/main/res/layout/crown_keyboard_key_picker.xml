<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_drawing"
    style="@style/VirtualKeyboardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/keyboard_picker_tabs" />

    <HorizontalScrollView
        android:id="@+id/device_keyboard_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbarStyle="insideOverlay">

        <com.limelight.binding.input.advance_setting.DeviceKeyboardPagesLayout
            android:id="@+id/device_keyboard_pages"
            android:layout_width="600dp"
            android:layout_height="match_parent">

            <include android:id="@+id/keyboard_picker_main" layout="@layout/layout_keyboard_main" />
            <include android:id="@+id/keyboard_picker_nav" layout="@layout/layout_keyboard_nav" android:visibility="gone" />
            <include android:id="@+id/keyboard_picker_num" layout="@layout/layout_keyboard_numpad" android:visibility="gone" />
        </com.limelight.binding.input.advance_setting.DeviceKeyboardPagesLayout>
    </HorizontalScrollView>
</LinearLayout>
