<?xml version="1.0" encoding="utf-8"?>
<com.limelight.binding.input.advance_setting.superpage.SuperPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="380dp"
    android:layout_height="match_parent"
    android:tag="380">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/crown_config_panel_bg"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/crown_config_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/crown_page_title" />

            <LinearLayout
                android:id="@+id/crown_config_segments"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/crown_config_section_bg"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/crown_config_segment_layout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/crown_segment_unselected_bg"
                    android:gravity="center"
                    android:text="@string/crown_config_segment_layout"
                    android:textColor="@color/crown_text_secondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/crown_config_segment_touch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/crown_segment_unselected_bg"
                    android:gravity="center"
                    android:text="@string/crown_config_segment_touch"
                    android:textColor="@color/crown_text_secondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/crown_config_segment_feedback"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/crown_segment_unselected_bg"
                    android:gravity="center"
                    android:text="@string/crown_config_segment_feedback"
                    android:textColor="@color/crown_text_secondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/crown_config_layout_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/page_config_section_profile"
                    style="@style/CrownSectionLabel" />

                <LinearLayout
                    android:id="@+id/crown_config_profile_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/crown_config_section_bg"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/layout_page_config_text_9eba2"
                        android:textColor="@color/crown_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/page_config_profile_hint"
                        android:textColor="@color/crown_text_secondary"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:id="@+id/config_profile_picker"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/crown_config_input_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.limelight.binding.input.advance_setting.CrownThumbnailView
                            android:id="@+id/config_selected_profile_thumbnail"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no">
                        </com.limelight.binding.input.advance_setting.CrownThumbnailView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/config_selected_profile_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="default"
                                android:textColor="@color/crown_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/config_selected_profile_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/crown_text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="›"
                            android:textColor="@color/crown_text_secondary"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/add_config_button"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/crown_action_icon_button_bg"
                            android:contentDescription="@string/layout_page_config_text_66ab5"
                            android:padding="11dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/phc_action_plus"
                            android:tint="@color/crown_text_primary" />

                        <ImageButton
                            android:id="@+id/rename_config_button"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/crown_action_icon_button_bg"
                            android:contentDescription="@string/layout_config_item_text_c8ce4"
                            android:padding="11dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/phc_action_edit"
                            android:tint="@color/crown_text_primary" />

                        <ImageButton
                            android:id="@+id/delete_config_button"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/crown_action_icon_button_bg"
                            android:contentDescription="@string/layout_config_item_text_2f4aa"
                            android:padding="11dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/phc_action_trash"
                            android:tint="@color/app_action_sheet_danger" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/crown_config_touch_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/page_config_section_touch"
                style="@style/CrownSectionLabel" />

            <LinearLayout
                android:id="@+id/crown_config_touch_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/crown_config_section_bg"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/layout_page_config_text_83a23"
                        android:textColor="@color/crown_text_primary"
                        android:textSize="13sp" />

                    <com.limelight.utils.AppSwitchView
                        style="@style/AppSwitchWidget"
                        android:id="@+id/mouse_enable_switch"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/layout_page_config_text_f4b7c"
                        android:textColor="@color/crown_text_primary"
                        android:textSize="13sp" />

                    <com.limelight.utils.AppSwitchView
                        style="@style/AppSwitchWidget"
                        android:id="@+id/trackpad_enable_switch"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/enhanced_touch_layout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/layout_page_config_text_8ea81"
                        android:textColor="@color/crown_text_primary"
                        android:textSize="13sp" />

                    <com.limelight.utils.AppSwitchView
                        style="@style/AppSwitchWidget"
                        android:id="@+id/enhanced_touch_switch"
                        android:checked="false" />
                </LinearLayout>

                <com.limelight.utils.AppSwitchView
                    style="@style/AppSwitchWidget"
                    android:id="@+id/apply_touchpad_sensitivity_switch"
                    android:layout_width="match_parent"
                    android:minHeight="48dp"
                    android:text="@string/game_menu_touchpad_sensitivity"
                    android:textColor="@color/crown_text_primary"
                    android:textSize="13sp" />

                <com.limelight.binding.input.advance_setting.superpage.NumberSeekbar
                    android:id="@+id/mouse_sense_number_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    app:max="1000"
                    app:min="1"
                    app:progress="100"
                    app:text="@string/apptext_pg_config_835d4" />

                <com.limelight.utils.AppSwitchView
                    style="@style/AppSwitchWidget"
                    android:id="@+id/apply_mouse_wheel_speed_switch"
                    android:layout_width="match_parent"
                    android:minHeight="48dp"
                    android:text="@string/apptext_pg_config_3f729"
                    android:textColor="@color/crown_text_primary"
                    android:textSize="13sp" />

                <com.limelight.binding.input.advance_setting.superpage.NumberSeekbar
                    android:id="@+id/mouse_wheel_speed_number_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    app:max="100"
                    app:min="1"
                    app:progress="20"
                    app:text="@string/apptext_pg_config_3f729" />
            </LinearLayout>

            <TextView
                android:id="@+id/crown_config_feedback_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/page_config_section_feedback"
                style="@style/CrownSectionLabel" />

            <LinearLayout
                android:id="@+id/crown_config_feedback_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/crown_config_section_bg"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/layout_page_config_text_cd2c1"
                        android:textColor="@color/crown_text_primary"
                        android:textSize="13sp" />

                    <com.limelight.utils.AppSwitchView
                        style="@style/AppSwitchWidget"
                        android:id="@+id/game_vibrator_enable_switch"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/layout_page_config_text_f4651"
                        android:textColor="@color/crown_text_primary"
                        android:textSize="13sp" />

                    <com.limelight.utils.AppSwitchView
                        style="@style/AppSwitchWidget"
                        android:id="@+id/button_vibrator_enable_switch"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:importantForAccessibility="no" />

        </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/crown_section_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/exit_crown_config_button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/crown_primary_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/crown_edit_done"
                    android:textColor="@color/crown_on_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.limelight.binding.input.advance_setting.superpage.SuperPageLayout>
