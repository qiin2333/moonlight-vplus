<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layer_6_keyboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <com.limelight.binding.input.advance_setting.KeyboardTouchGuardLayout
        android:id="@+id/keyboard_content"
        android:layout_width="400dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/keyboard_dock_bg"
        android:clipChildren="false"
        android:elevation="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/keyboard_rail"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/keyboard_rail_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.limelight.binding.input.advance_setting.KeyboardGripView
                android:id="@+id/keyboard_drag_grip"
                android:layout_width="20dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/keyboard_drag_handle" />

            <TextView
                android:id="@+id/btn_key_page_main"
                style="@style/KeyboardRailTab"
                android:drawableStart="@drawable/ic_keyboard_tab_main"
                android:text="@string/keyboard_tab_main" />

            <TextView
                android:id="@+id/btn_key_page_num"
                style="@style/KeyboardRailTab"
                android:drawableStart="@drawable/ic_keyboard_tab_num"
                android:text="@string/keyboard_tab_num" />

            <TextView
                android:id="@+id/btn_key_page_nav"
                style="@style/KeyboardRailTab"
                android:drawableStart="@drawable/ic_keyboard_tab_nav"
                android:text="@string/keyboard_tab_nav" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_keyboard_opacity"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/keyboard_opacity"
                android:focusable="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_keyboard_opacity"
                app:tint="@color/crown_text_secondary" />

            <ImageButton
                android:id="@+id/btn_keyboard_mini"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/keyboard_mini"
                android:focusable="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_keyboard_mini"
                app:tint="@color/crown_text_secondary" />

            <ImageButton
                android:id="@+id/btn_keyboard_resize"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/keyboard_resize"
                android:focusable="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_keyboard_resize"
                app:tint="@color/crown_text_secondary" />

            <ImageButton
                android:id="@+id/btn_keyboard_hide"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/keyboard_hide"
                android:focusable="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_keyboard_hide"
                app:tint="@color/crown_text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/keyboard_page_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp">

            <com.limelight.binding.input.advance_setting.KeyboardMainPageView
                android:id="@+id/layout_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.limelight.binding.input.advance_setting.KeyboardPageView
                android:id="@+id/layout_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.limelight.binding.input.advance_setting.KeyboardPageView
                android:id="@+id/layout_num"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </com.limelight.binding.input.advance_setting.KeyboardTouchGuardLayout>

    <LinearLayout
        android:id="@+id/keyboard_modifier_chips"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:background="@drawable/keyboard_chip_bar_bg"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/keyboard_key_popup"
        android:layout_width="50dp"
        android:layout_height="64dp"
        android:background="@drawable/keyboard_popup_bg"
        android:elevation="30dp"
        android:gravity="top|center_horizontal"
        android:paddingTop="12dp"
        android:textColor="@color/crown_keyboard_popup_text"
        android:textSize="28sp"
        android:textStyle="bold"
        android:translationZ="30dp"
        android:visibility="gone" />
</FrameLayout>