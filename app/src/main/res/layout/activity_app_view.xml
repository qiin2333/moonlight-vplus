<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/advance_setting_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".AppView">

    <!-- 背景图容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 高斯模糊背景 -->
        <ImageView
            android:id="@+id/appBackgroundImageBlur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 中间完整图片 -->
        <com.limelight.utils.AcrylicImageView
            android:id="@+id/appBackgroundImageClear"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <!-- 应用网格本身保持在页面中央，标题和提示紧贴其上沿。 -->
    <FrameLayout
        android:id="@+id/appCatalogFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/appFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:id="@+id/selectionIndicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/selection_indicator"
            android:visibility="invisible"
            android:elevation="8dp"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </FrameLayout>

    <!-- 标题区域（电脑名 + 应用名 + 恢复箭头），与列表保持固定间距。 -->
    <LinearLayout
        android:id="@+id/appContentColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/appCatalogFrame"
        android:layout_marginStart="@dimen/appview_content_margin"
        android:layout_marginEnd="@dimen/appview_content_margin"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="end">

        <!-- 短横屏为中间的顶部手柄预留区域；竖屏和高横屏由资源恢复完整宽度。 -->
        <Space
            android:id="@+id/appHeaderLeadingSpace"
            android:layout_width="@dimen/appview_header_spacer_width"
            android:layout_height="0dp"
            android:layout_weight="@integer/appview_header_spacer_weight"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <!-- 标题区域（电脑名 + 应用名 + 恢复箭头） -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/appListText"
                style="@style/AppListTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:preferKeepClear="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/appview_title_background" />

            <!-- 常驻提示当前生效的非默认屏幕组合/显示器；仅用于信息展示。 -->
            <TextView
                android:id="@+id/appViewTargetReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/control_highlight_color"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="@integer/appview_target_reminder_max_lines"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:shadowColor="@color/appview_text_shadow"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:focusable="false"
                android:clickable="false"
                android:importantForAccessibility="yes"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- 底部信息固定在安全区域上方，不参与应用列表的垂直居中。 -->
    <LinearLayout
        android:id="@+id/bottomInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/appview_content_margin"
        android:layout_marginEnd="@dimen/appview_content_margin"
        android:layout_marginBottom="@dimen/appview_bottom_margin"
        android:orientation="vertical"
        android:gravity="end">

        <!-- 上一次设置信息 -->
        <LinearLayout
            android:id="@+id/lastSettingsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/useLastSettingsCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:focusable="true"
                android:text="@string/app_last_settings_use_checkbox"
                android:textColor="@color/appview_text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:buttonTint="@color/appview_text_primary"
                android:checked="false" />

            <TextView
                android:id="@+id/lastSettingsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/appview_text_secondary"
                android:shadowColor="@color/appview_text_shadow"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:fontFamily="sans-serif-light"
                android:background="@drawable/settings_info_background"
                android:padding="@dimen/appview_edge_margin"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:text="@string/app_last_settings_title" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/topPanelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- 顶部下拉手柄标签 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/topPanelToggle"
        android:layout_width="84dp"
        android:layout_height="36dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/activity_safearea_top"
        android:elevation="4dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="false" />

    <!-- 顶部下拉面板 -->

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/topDropdownPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topPanelToggle"
        android:layout_marginTop="-32dp"
        android:layout_centerHorizontal="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="@dimen/appview_panel_elevation"
        android:visibility="invisible" />

    <FrameLayout
        android:id="@+id/screenCombinationModeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_combination_mode_picker_background"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:visibility="gone" />

</RelativeLayout>
