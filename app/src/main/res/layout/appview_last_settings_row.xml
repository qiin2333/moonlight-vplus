<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="7dp">

    <TextView
        android:id="@+id/lastSettingsRowLabel"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.04"
        android:textColor="@color/appview_preset_text_tertiary"
        android:textSize="@dimen/appview_preset_detail_label_text_size" />

    <TextView
        android:id="@+id/lastSettingsRowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/appview_preset_text_secondary"
        android:textSize="@dimen/appview_preset_detail_value_text_size" />
</LinearLayout>
