<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_menu_dialog_background">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:id="@+id/settings_detail_header"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="720dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/settings_detail_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/settings_detail_back_background"
            android:contentDescription="@string/controller_diag_back"
            app:srcCompat="@drawable/ic_arrow_back_24"
            app:tint="@color/ui_shell_text_primary" />

        <TextView
            android:id="@+id/settings_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ui_shell_text_primary"
            android:textSize="22sp"
            android:shadowRadius="0" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settings_detail_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/settings_detail_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="720dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
