<?xml version="1.0" encoding="utf-8"?>
<com.limelight.binding.input.advance_setting.superpage.SuperPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="380dp"
    android:layout_height="match_parent"
    android:tag="380">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="5dp"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/page_edit_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/crown_config_panel_bg"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/crown_page_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/crown_edit_section_canvas"
                    android:textColor="?attr/appAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/crown_config_section_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/layout_page_edit_text_e8341"
                                android:textColor="@color/crown_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/crown_edit_drag_summary"
                                android:textColor="@color/crown_text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <com.limelight.utils.AppSwitchView
                            style="@style/AppSwitchWidget"
                            android:id="@+id/page_edit_drag_edit_switch"
                            android:checked="true"
                            android:textOff=""
                            android:textOn="" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ui_shell_outline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/crown_alignment_snap_switch"
                                android:textColor="@color/crown_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/crown_edit_snap_summary"
                                android:textColor="@color/crown_text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <com.limelight.utils.AppSwitchView
                            style="@style/AppSwitchWidget"
                            android:id="@+id/page_edit_alignment_snap_switch"
                            android:checked="true"
                            android:textOff=""
                            android:textOn="" />
                    </LinearLayout>

                    <com.limelight.binding.input.advance_setting.superpage.NumberSeekbar
                        android:id="@+id/page_edit_edit_grid_width"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        app:max="100"
                        app:min="1"
                        app:progress="1"
                        app:text="@string/apptext_pg_edit_458a8" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/crown_edit_section_buttons"
                    android:textColor="?attr/appAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12" />

                <LinearLayout
                    android:id="@+id/page_edit_add_digital_common_button"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_2c372">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_2c372" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/page_edit_add_digital_switch_button"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_c0c18">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_c0c18" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/page_edit_add_digital_movable_button"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_5817f">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_5817f" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/page_edit_add_pad"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_061fc">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_061fc" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/crown_edit_section_sticks"
                    android:textColor="?attr/appAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12" />

                <LinearLayout
                    android:id="@+id/page_edit_add_analog_stick"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_e0cc1">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_e0cc1" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/page_edit_add_digital_stick"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_6d757">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_6d757" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/page_edit_add_invisible_analog_stick"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_9851e">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_9851e" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/page_edit_add_invisible_digital_stick"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_b4881">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_b4881" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/page_edit_add_simplify_performance"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_e19e5">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_e19e5" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/crown_edit_section_containers"
                    android:textColor="?attr/appAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12" />

                <LinearLayout
                    android:id="@+id/page_edit_add_digital_combine_button"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_ed364">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_ed364" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/page_edit_add_wheel_pad"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_1483c">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_1483c" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/page_edit_add_group_button"
                    style="@style/CrownEditActionRow"
                    android:contentDescription="@string/layout_page_edit_text_bd823">
                    <TextView style="@style/CrownEditActionLabel" android:text="@string/layout_page_edit_text_bd823" />
                    <ImageView style="@style/CrownEditActionArrow" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="@string/crown_edit_canvas_hint"
                    android:textColor="@color/crown_text_secondary"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/crown_panel_background"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <ImageButton
                android:id="@+id/page_edit_auto_color_all"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/crown_action_icon_button_bg"
                android:contentDescription="@string/crown_auto_color_all_action"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/phc_action_auto_color"
                android:tint="@color/crown_text_primary" />

            <ImageButton
                android:id="@+id/page_edit_exit_edit_mode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/crown_action_icon_button_bg"
                android:clickable="true"
                android:contentDescription="@string/layout_page_edit_text_b8a5e"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/phc_action_exit"
                android:tint="@color/crown_text_primary" />
        </LinearLayout>
    </LinearLayout>
</com.limelight.binding.input.advance_setting.superpage.SuperPageLayout>
