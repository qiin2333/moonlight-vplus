<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景图片容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 高斯模糊背景 -->
        <ImageView
            android:id="@+id/appPosterBackgroundBlur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 中间完整图片 -->
        <com.limelight.utils.AcrylicImageView
            android:id="@+id/appPosterBackgroundClear"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <!-- 半透明遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#48000000" />

    <!-- 中心聚光：让月相构图在任意封面上都有可读性，同时把视线收向中间。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/loading_spotlight" />

    <!-- 底部渐隐：托住小课堂文案。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/loading_bottom_scrim" />

    <!-- 主内容块在小屏幕 / 大字号下可能高过小课堂：约束在小课堂上方的剩余空间内
         居中，而不是在整个窗口居中，保证阶段文案永远压不到小课堂。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/randomTip"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <com.limelight.ui.MoonwaxLoaderView
            android:id="@+id/loading_moonwax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />

        <!-- 状态标题 -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:textColor="#F5FFFFFF"
            android:textSize="20sp" />

        <!-- 阶段文案 -->
        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="8"
            android:textColor="#A6FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 随机提示 -->
    <TextView
        android:id="@+id/randomTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="36dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:textColor="#8CFFFFFF"
        android:textSize="12sp" />

</RelativeLayout>
