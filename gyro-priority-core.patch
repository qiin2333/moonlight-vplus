index 9affe26..1258b67 100644
--- a/src/ControlStream.c
+++ b/src/ControlStream.c
@@ -1,4 +1,19 @@
 #include "Limelight-internal.h"
+
+#if defined(__ANDROID__)
+#include <sys/resource.h>
+#include <unistd.h>
+// Run latency-critical input threads ahead of video decoding and presentation
+// (which V+ runs at THREAD_PRIORITY_DISPLAY / URGENT_DISPLAY). -19 matches
+// Android's THREAD_PRIORITY_URGENT_AUDIO, the highest an app thread may use.
+static void raiseInputThreadPriority(const char* name) {
+    if (setpriority(PRIO_PROCESS, gettid(), -19) != 0) {
+        Limelog("Unable to raise %s thread priority\n", name);
+    }
+}
+#else
+static void raiseInputThreadPriority(const char* name) { (void)name; }
+#endif
