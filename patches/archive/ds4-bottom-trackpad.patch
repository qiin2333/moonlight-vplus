+            isMotionEventSplittingEnabled = true
+            gamepadViews.forEach { addView(it) }
+            keyboardViews.forEach { addView(it) }
+            addView(textSink)
+            addView(wheel) // over the pages when open
+            addView(banner) // status messages, on top of everything
+            showPage()
+            wake()
+            startPixelShift()
