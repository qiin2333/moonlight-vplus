+
+        // Never let ENet's congestion throttle discard unreliable input. Gyro and
+        // accelerometer samples are sent unreliable; with the default deceleration,
+        // a short burst of slow ACKs (RTT above the 5-second minimum plus twice the
+        // variance) drives packetThrottle to 0 and silently drops nearly all motion
+        // packets until RTT returns to its minimum. A deceleration of 0 pins the
+        // throttle at its limit. Reliable traffic is unaffected.
+        enet_peer_throttle_configure(peer, ENET_PEER_PACKET_THROTTLE_INTERVAL,
+                                     ENET_PEER_PACKET_THROTTLE_ACCELERATION, 0);
     }
