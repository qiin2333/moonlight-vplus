@@ -0,0 +1,684 @@
+@file:Suppress("DEPRECATION")
+package com.limelight
+
+// Bottom-screen DualShock 4 touchpad and hotkeys for dual-screen handhelds (AYN Thor, Retroid Pocket Duo).
+//
+// Pad look and pad/click behaviour are ported from DroidDeck's "Deck trackpads" panels
+// (https://github.com/Droid-Deck/DroidDeck, ui/InputSurfaceView.kt TrackpadView/HoldButton,
+// input/DualScreen.kt), licensed GPL-3.0 like Moonlight V+.
+//
+// Layout: two large pads side by side, with a bottom row [ CLICK | MENU KEYS ESC COLOR | CLICK ].
+// The pads are the left and right halves of controller 0's DS4 touchpad; each carries one contact
+// (pointer 0 = left, 1 = right), matching the host's two DS4 touch slots. Touchpad click: the CLICK
+// button under a pad, a quick tap, or a second finger on the pad. The pad's contact is held while
+// clicked so the host knows which half was clicked.
+//
+// Edge swipes: the bottom screen hides its system bars (sticky immersive) and excludes both side
+// edges from Android's back gesture, so a swipe that starts at the bezel lands on the pad. Android
+// only lifts its 200dp-per-edge exclusion limit while the navigation bar is stickily hidden; if the
+// platform keeps the bar shown for this window, the 200dp band around the middle of each pad is
+// excluded instead, and Back from the rest of the edge is still ignored by the stream menu.
+//
+// OLED care: pure black background, no filled panels, dims after 10 s without a touch and goes fully
+// black after 60 s (the pads keep working; any touch wakes it), and the whole layout shifts by a few
+// pixels every minute so static outlines never sit on the same pixels.
+
+import android.annotation.SuppressLint
+import android.app.Presentation
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RadialGradient
+import android.graphics.Rect
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import android.graphics.drawable.ColorDrawable
+import android.hardware.display.DisplayManager
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.view.Display
+import android.view.HapticFeedbackConstants
+import android.view.KeyEvent
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewConfiguration
+import android.view.ViewGroup
+import android.view.WindowInsets
+import android.view.WindowInsetsController
+import android.view.WindowManager
+import com.limelight.nvstream.input.ControllerPacket
+import com.limelight.nvstream.jni.MoonBridge
+import kotlin.math.abs
+import kotlin.math.min
+
+class SecondScreenTrackpad(private val game: Game) {
+    private var presentation: PadPresentation? = null
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private val actions by lazy { StreamActionExecutor(game, { game.conn }) }
+    private val prefs by lazy { game.getSharedPreferences(PREFS, Context.MODE_PRIVATE) }
+
+    @Volatile private var lastTouchUptime = 0L
+    @Volatile private var touchesDown = 0
+
+    fun show() {
+        if (presentation != null) return
+        if (game.externalDisplayManager?.isUsingExternalDisplay() == true) return
+        val displayManager = game.getSystemService(Context.DISPLAY_SERVICE) as? DisplayManager ?: return
+        val display = builtInSecondDisplay(displayManager, game.windowManager.defaultDisplay.displayId) ?: return
+        val created = PadPresentation(game, display)
+        try {
+            created.show()
+            presentation = created
+            LimeLog.info("Bottom-screen DS4 touchpad shown on display ${display.displayId}")
+        } catch (e: WindowManager.InvalidDisplayException) {
+            LimeLog.warning("Bottom-screen DS4 touchpad unavailable: ${e.message}")
+        }
+    }
+
+    fun dismiss() {
+        val current = presentation ?: return
+        presentation = null
+        current.release()
+        try {
+            current.dismiss()
+        } catch (e: Exception) {
+            LimeLog.warning("Bottom-screen DS4 touchpad dismiss failed: $e")
+        }
+    }
+
+    /**
+     * True when a Back event was caused by an edge swipe on the bottom screen (Android's back
+     * gesture) rather than a deliberate Back. Game.onBackPressed() ignores Back in that case, so
+     * swiping on the pads never opens the stream menu. Use the MENU hotkey to open it instead.
+     */
+    fun shouldSwallowBack(): Boolean =
+        presentation != null &&
+            (touchesDown > 0 || SystemClock.uptimeMillis() - lastTouchUptime < BACK_GUARD_MS)
+
+    // ---------------------------------------------------------------- display (from DroidDeck DualScreen)
+
+    private fun builtInSecondDisplay(displayManager: DisplayManager, primaryDisplayId: Int): Display? =
+        displayManager.getDisplays(DisplayManager.DISPLAY_CATEGORY_PRESENTATION).firstOrNull {
+            it.isValid && it.displayId != primaryDisplayId &&
+                (it.flags and Display.FLAG_PRESENTATION) != 0 &&
+                it.state != Display.STATE_OFF && isBuiltIn(it)
+        }
+
+    private fun isBuiltIn(display: Display): Boolean {
+        val type = runCatching { Display::class.java.getMethod("getType").invoke(display) as Int }.getOrNull()
+        if (type != null) return type == TYPE_INTERNAL
+        val model = Build.MODEL.trim().lowercase()
+        return KNOWN_DUAL_SCREEN_MODELS.any { model.startsWith(it) }
+    }
+
+    // ---------------------------------------------------------------- colours
+
+    private var themeIndex = 0
+    private val accent: Int get() = THEMES[themeIndex]
+
+    private fun loadTheme() {
+        themeIndex = prefs.getInt(PREF_THEME, 0).coerceIn(0, THEMES.size - 1)
+    }
+
+    private fun nextTheme() {
+        themeIndex = (themeIndex + 1) % THEMES.size
+        prefs.edit().putInt(PREF_THEME, themeIndex).apply()
+    }
+
+    private fun withAlpha(color: Int, alpha: Int) = (color and 0x00ffffff) or (alpha shl 24)
+
+    // ---------------------------------------------------------------- controller output
+
+    private val padClicks = BooleanArray(2)
+
+    private fun sendContact(side: Int, type: Byte, fx: Float, fy: Float) {
+        // Left pad covers x 0.0..0.5 of the DS4 touchpad, right pad 0.5..1.0
+        val x = (side * 0.5f + fx.coerceIn(0f, 1f) * 0.5f).coerceIn(0f, 1f)
+        val y = fy.coerceIn(0f, 1f)
+        val pressure = if (type == MoonBridge.LI_TOUCH_EVENT_UP) 0f else 1f
+        game.conn?.sendControllerTouchEvent(0, type, side, x, y, pressure)
+    }
+
+    private fun pushButtons() {
+        var mask = 0
+        if (padClicks[0] || padClicks[1]) mask = mask or ControllerPacket.TOUCHPAD_FLAG
+        game.controllerHandler.setSecondScreenButtons(mask)
+    }
+
+    private fun setPadClick(side: Int, down: Boolean) {
+        if (padClicks[side] == down) return
+        padClicks[side] = down
+        pushButtons()
+    }
+
+    private fun releaseAll() {
+        padClicks[0] = false
+        padClicks[1] = false
+        game.controllerHandler.setSecondScreenButtons(0)
+        game.conn?.sendControllerTouchEvent(0, MoonBridge.LI_TOUCH_EVENT_CANCEL_ALL, 0, 0f, 0f, 0f)
+    }
+
+    // ---------------------------------------------------------------- window
+
+    private inner class PadPresentation(context: Context, display: Display) : Presentation(context, display) {
+        private var root: PadLayout? = null
+
+        override fun onCreate(savedInstanceState: Bundle?) {
+            super.onCreate(savedInstanceState)
+            // Not focusable, as in DroidDeck: the stream window keeps controller and key focus.
+            window?.addFlags(
+                WindowManager.LayoutParams.FLAG_FULLSCREEN or
+                    WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON or
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+            )
+            // Black window behind the layout, so the anti-burn-in pixel shift never exposes another colour
+            window?.setBackgroundDrawable(ColorDrawable(Color.BLACK))
+            loadTheme()
+            val layout = PadLayout(context)
+            root = layout
+            setContentView(layout)
+            hideSystemBars()
+        }
+
+        // Sticky immersive: lifts Android's 200dp limit on back-gesture exclusion for this screen.
+        private fun hideSystemBars() {
+            val w = window ?: return
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                w.setDecorFitsSystemWindows(false)
+                w.insetsController?.let {
+                    it.systemBarsBehavior = WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+                    it.hide(WindowInsets.Type.systemBars())
+                }
+            } else {
+                w.decorView.systemUiVisibility = View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY or
+                    View.SYSTEM_UI_FLAG_HIDE_NAVIGATION or
+                    View.SYSTEM_UI_FLAG_FULLSCREEN or
+                    View.SYSTEM_UI_FLAG_LAYOUT_STABLE or
+                    View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION or
+                    View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
+            }
+        }
+
+        // Fallback if the platform still routes input here: hand it back to the stream,
+        // except a gesture-generated Back.
+        override fun dispatchKeyEvent(event: KeyEvent): Boolean {
+            if (event.keyCode == KeyEvent.KEYCODE_BACK && shouldSwallowBack()) return true
+            return game.dispatchKeyEvent(event)
+        }
+
+        override fun dispatchGenericMotionEvent(event: MotionEvent): Boolean =
+            game.dispatchGenericMotionEvent(event)
+
+        override fun onDisplayRemoved() {
+            super.onDisplayRemoved()
+            release()
+        }
+
+        fun release() {
+            root?.release()
+        }
+    }
+
+    // ---------------------------------------------------------------- layout
+
+    private inner class PadLayout(context: Context) : ViewGroup(context) {
+        private val density = resources.displayMetrics.density
+        private val leftPad = TrackpadView(context, LEFT)
+        private val rightPad = TrackpadView(context, RIGHT)
+        private val leftClick = ClickStripView(context, leftPad)
+        private val rightClick = ClickStripView(context, rightPad)
+        private val hotkeys = listOf(
+            HotkeyView(context, "MENU") { actions.execute("open_menu") },
+            HotkeyView(context, "KEYS") { actions.execute("open_keyboard") },
+            HotkeyView(context, "ESC") { actions.execute("send_esc") },
+            HotkeyView(context, "COLOR") { nextTheme(); invalidateAll() },
+        )
+        private val gestureRects = listOf(Rect(), Rect())
+
+        private var dimmed = false
+        private var off = false
+        private var shiftStep = 0
+        private val dimRunnable = Runnable { setLevel(dim = true, black = false) }
+        private val offRunnable = Runnable { setLevel(dim = true, black = true) }
+        private val shiftRunnable = object : Runnable {
+            override fun run() {
+                shiftStep = (shiftStep + 1) % SHIFT_PATTERN.size
+                translationX = SHIFT_PATTERN[shiftStep].first * density
+                translationY = SHIFT_PATTERN[shiftStep].second * density
+                mainHandler.postDelayed(this, SHIFT_INTERVAL_MS)
+            }
+        }
+
+        init {
+            setBackgroundColor(Color.BLACK)
+            isMotionEventSplittingEnabled = true
+            addView(leftPad)
+            addView(rightPad)
+            addView(leftClick)
+            addView(rightClick)
+            hotkeys.forEach { addView(it) }
+            wake()
+            mainHandler.postDelayed(shiftRunnable, SHIFT_INTERVAL_MS)
+        }
+
+        override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+            val w = (r - l).toFloat()
+            val h = (b - t).toFloat()
+            // Pads fill the screen down to the bottom row; they meet the side bezels.
+            place(leftPad, 0f, .02f, .495f, PAD_BOTTOM - .02f, w, h)
+            place(rightPad, .505f, .02f, .495f, PAD_BOTTOM - .02f, w, h)
+            // Bottom row: a CLICK under each pad, the four hotkeys between them
+            val rowY = PAD_BOTTOM + .02f
+            val rowH = .98f - rowY
+            place(leftClick, 0f, rowY, .22f, rowH, w, h)
+            place(rightClick, .78f, rowY, .22f, rowH, w, h)
+            val gap = .012f
+            val each = (.56f - .024f - gap * (hotkeys.size - 1)) / hotkeys.size
+            hotkeys.forEachIndexed { i, v -> place(v, .232f + i * (each + gap), rowY, each, rowH, w, h) }
+            updateGestureExclusion()
+        }
+
+        override fun onApplyWindowInsets(insets: WindowInsets): WindowInsets {
+            post { updateGestureExclusion() }
+            return super.onApplyWindowInsets(insets)
+        }
+
+        // Keep Android's back gesture off both side edges so edge swipes reach the pads.
+        private fun updateGestureExclusion() {
+            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q || width == 0 || height == 0) return
+            val navHidden = Build.VERSION.SDK_INT >= Build.VERSION_CODES.R &&
+                rootWindowInsets?.isVisible(WindowInsets.Type.navigationBars()) == false
+            var top = 0
+            var bottom = height
+            if (!navHidden) {
+                // Outside sticky immersive Android honours only 200dp per edge: put it mid-pad.
+                val band = (EXCLUSION_LIMIT_DP * density).toInt()
+                if (band < height) {
+                    val centre = (height * PAD_BOTTOM / 2f).toInt()
+                    top = (centre - band / 2).coerceAtLeast(0)
+                    bottom = (top + band).coerceAtMost(height)
+                }
+            }
+            gestureRects[0].set(0, top, width / 2, bottom)
+            gestureRects[1].set(width / 2, top, width, bottom)
+            systemGestureExclusionRects = gestureRects
+        }
+
+        private fun place(v: View, x: Float, y: Float, width: Float, height: Float, w: Float, h: Float) {
+            val left = (x * w).toInt()
+            val top = (y * h).toInt()
+            val right = ((x + width) * w).toInt()
+            val bottom = ((y + height) * h).toInt()
+            v.measure(
+                MeasureSpec.makeMeasureSpec(right - left, MeasureSpec.EXACTLY),
+                MeasureSpec.makeMeasureSpec(bottom - top, MeasureSpec.EXACTLY)
+            )
+            v.layout(left, top, right, bottom)
+        }
+
+        override fun dispatchTouchEvent(event: MotionEvent): Boolean {
+            lastTouchUptime = SystemClock.uptimeMillis()
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> touchesDown = 1
+                MotionEvent.ACTION_POINTER_DOWN -> touchesDown = event.pointerCount
+                MotionEvent.ACTION_POINTER_UP -> touchesDown = event.pointerCount - 1
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> touchesDown = 0
+            }
+            if (event.actionMasked == MotionEvent.ACTION_DOWN || event.actionMasked == MotionEvent.ACTION_POINTER_DOWN) wake()
+            else if (event.actionMasked == MotionEvent.ACTION_UP || event.actionMasked == MotionEvent.ACTION_CANCEL) scheduleIdle()
+            return super.dispatchTouchEvent(event)
+        }
+
+        private fun wake() {
+            mainHandler.removeCallbacks(dimRunnable)
+            mainHandler.removeCallbacks(offRunnable)
+            setLevel(dim = false, black = false)
+            scheduleIdle()
+        }
+
+        private fun scheduleIdle() {
+            mainHandler.removeCallbacks(dimRunnable)
+            mainHandler.removeCallbacks(offRunnable)
+            mainHandler.postDelayed(dimRunnable, DIM_AFTER_MS)
+            mainHandler.postDelayed(offRunnable, OFF_AFTER_MS)
+        }
+
+        private fun setLevel(dim: Boolean, black: Boolean) {
+            if (dimmed == dim && off == black) return
+            dimmed = dim
+            off = black
+            val a = when {
+                black -> 0f
+                dim -> DIM_ALPHA
+                else -> 1f
+            }
+            for (i in 0 until childCount) getChildAt(i).alpha = a
+        }
+
+        fun invalidateAll() {
+            for (i in 0 until childCount) getChildAt(i).invalidate()
+        }
+
+        fun release() {
+            mainHandler.removeCallbacks(dimRunnable)
+            mainHandler.removeCallbacks(offRunnable)
+            mainHandler.removeCallbacks(shiftRunnable)
+            leftPad.reset()
+            rightPad.reset()
+            leftClick.reset()
+            rightClick.reset()
+            hotkeys.forEach { it.reset() }
+            touchesDown = 0
+            releaseAll()
+        }
+    }
+
+    // ---------------------------------------------------------------- drawing (after DroidDeck Surface)
+
+    private abstract inner class Surface(context: Context) : View(context) {
+        protected val density = resources.displayMetrics.density
+        protected val rect = RectF()
+        private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val stroke = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
+        protected val labelPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.CENTER
+            typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
+        }
+        protected val captionPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { textAlign = Paint.Align.CENTER }
+
+        /** Outline-only panel (no fill when idle, for OLED); a faint accent wash only while lit. */
+        protected fun drawSurface(canvas: Canvas, lit: Boolean, corner: Float = CORNER) {
+            val inset = density
+            rect.set(inset, inset, width - inset, height - inset)
+            val radius = corner * density
+            if (lit) {
+                fill.color = withAlpha(accent, 0x2E)
+                canvas.drawRoundRect(rect, radius, radius, fill)
+            }
+            stroke.color = if (lit) accent else withAlpha(accent, IDLE_LINE_ALPHA)
+            stroke.strokeWidth = (if (lit) 2f else 1f) * density
+            canvas.drawRoundRect(rect, radius, radius, stroke)
+        }
+
+        protected fun feedback() {
+            performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY)
+        }
+    }
+
+    // ---------------------------------------------------------------- pad (from DroidDeck TrackpadView)
+
+    private inner class TrackpadView(context: Context, val side: Int) : Surface(context) {
+        private var touching = false
+        private var fingerDown = false
+        private var touchClick = false
+        private var stripDown = false
+        private var clicked = false
+        private var fingerX = 0f
+        private var fingerY = 0f
+        private var downTime = 0L
+        private var downX = 0f
+        private var downY = 0f
+        private var tapCandidate = false
+        private var pendingTapRelease: Runnable? = null
+        private val slop = ViewConfiguration.get(context).scaledTouchSlop.toFloat()
+        private val guide = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
+        private val dot = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val glow = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val caption = if (side == LEFT) "LEFT TRACKPAD" else "RIGHT TRACKPAD"
+
+        override fun onDraw(canvas: Canvas) {
+            drawSurface(canvas, clicked)
+            val cx = width / 2f
+            val cy = height / 2f
+            guide.color = withAlpha(accent, GUIDE_ALPHA)
+            guide.strokeWidth = density
+            val reach = min(width, height) / 2f - 24 * density
+            if (reach > 0) {
+                canvas.drawCircle(cx, cy, reach, guide)
+                canvas.drawCircle(cx, cy, reach / 2f, guide)
+                canvas.drawLine(cx - reach, cy, cx + reach, cy, guide)
+                canvas.drawLine(cx, cy - reach, cx, cy + reach, guide)
+            }
+            captionPaint.textSize = 12 * density
+            captionPaint.color = if (touching) accent else withAlpha(TEXT_DIM, 0xFF)
+            canvas.drawText(caption, cx, 28 * density, captionPaint)
+            if (touching) {
+                val radius = 56 * density
+                glow.shader = RadialGradient(fingerX, fingerY, radius, withAlpha(accent, 0x66), Color.TRANSPARENT, Shader.TileMode.CLAMP)
+                canvas.drawCircle(fingerX, fingerY, radius, glow)
+                dot.color = accent
+                canvas.drawCircle(fingerX, fingerY, (if (clicked) 16 else 12) * density, dot)
+            }
+        }
+
+        @SuppressLint("ClickableViewAccessibility")
+        override fun onTouchEvent(event: MotionEvent): Boolean {
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    flushPendingTap()
+                    fingerDown = true
+                    downTime = event.eventTime
+                    downX = event.x
+                    downY = event.y
+                    tapCandidate = true
+                    touch(event.x, event.y)
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    if (tapCandidate && (abs(event.x - downX) > slop || abs(event.y - downY) > slop)) tapCandidate = false
+                    touch(event.getX(0), event.getY(0))
+                    click(event.pointerCount > 1)
+                }
+                MotionEvent.ACTION_POINTER_DOWN -> {
+                    tapCandidate = false
+                    click(true)
+                }
+                MotionEvent.ACTION_POINTER_UP -> {
+                    val stays = if (event.actionIndex == 0) 1 else 0
+                    touch(event.getX(stays), event.getY(stays))
+                    click(event.pointerCount - 1 > 1)
+                }
+                MotionEvent.ACTION_UP -> {
+                    val tap = tapCandidate && event.eventTime - downTime <= TAP_MS
+                    tapCandidate = false
+                    fingerDown = false
+                    if (tap) {
+                        // Quick tap = touchpad click, with the contact still down so the host knows the side.
+                        click(true)
+                        val release = Runnable {
+                            pendingTapRelease = null
+                            click(false)
+                            liftIfFree()
+                        }
+                        pendingTapRelease = release
+                        mainHandler.postDelayed(release, TAP_CLICK_HOLD_MS)
+                    } else {
+                        click(false)
+                        liftIfFree()
+                    }
+                }
+                MotionEvent.ACTION_CANCEL -> {
+                    tapCandidate = false
+                    fingerDown = false
+                    flushPendingTap()
+                    click(false)
+                    liftIfFree()
+                }
+            }
+            return true
+        }
+
+        private fun flushPendingTap() {
+            val pending = pendingTapRelease ?: return
+            pendingTapRelease = null
+            mainHandler.removeCallbacks(pending)
+            pending.run()
+        }
+
+        private fun touch(x: Float, y: Float) {
+            fingerX = x.coerceIn(0f, width.toFloat())
+            fingerY = y.coerceIn(0f, height.toFloat())
+            val type = if (touching) MoonBridge.LI_TOUCH_EVENT_MOVE else MoonBridge.LI_TOUCH_EVENT_DOWN
+            touching = true
+            sendContact(side, type, fingerX / width.coerceAtLeast(1), fingerY / height.coerceAtLeast(1))
+            invalidate()
+        }
+
+        // Lift the contact unless the CLICK button is still holding it.
+        private fun liftIfFree() {
+            if (!stripDown) lift()
+        }
+
+        private fun lift() {
+            if (!touching) return
+            touching = false
+            sendContact(side, MoonBridge.LI_TOUCH_EVENT_UP, fingerX / width.coerceAtLeast(1), fingerY / height.coerceAtLeast(1))
+            invalidate()
+        }
+
+        // Click from the pad itself (tap or second finger)
+        private fun click(down: Boolean) {
+            touchClick = down
+            applyClick()
+        }
+
+        /**
+         * CLICK button under this pad. With no finger on the pad the contact is held at the last
+         * position (centre if none yet), so the host still sees which half of the DS4 pad is clicked.
+         */
+        fun stripPress(down: Boolean) {
+            if (stripDown == down) return
+            stripDown = down
+            if (down && !touching) touch(if (fingerX > 0f) fingerX else width / 2f, if (fingerY > 0f) fingerY else height / 2f)
+            applyClick()
+            if (!down && !fingerDown && pendingTapRelease == null) lift()
+        }
+
+        private fun applyClick() {
+            val down = touchClick || stripDown
+            if (clicked == down) return
+            clicked = down
+            if (down && !stripDown) feedback() // the CLICK button gives its own haptic
+            setPadClick(side, down)
+            invalidate()
+        }
+
+        fun reset() {
+            pendingTapRelease?.let { mainHandler.removeCallbacks(it) }
+            pendingTapRelease = null
+            clicked = false
+            touchClick = false
+            stripDown = false
+            fingerDown = false
+            touching = false
+            tapCandidate = false
+            invalidate()
+        }
+    }
+
+    // ---------------------------------------------------------------- hotkey (after DroidDeck HoldButton)
+
+    private open inner class HotkeyView(
+        context: Context,
+        private val label: String,
+        private val onPress: () -> Unit
+    ) : Surface(context) {
+        private var pressedDown = false
+
+        override fun onDraw(canvas: Canvas) {
+            drawSurface(canvas, pressedDown, corner = HOTKEY_CORNER)
+            labelPaint.color = if (pressedDown) Color.WHITE else withAlpha(TEXT, 0xFF)
+            labelPaint.textSize = min(height * .32f, 16 * density)
+            val labelWidth = labelPaint.measureText(label)
+            if (labelWidth > width * .84f) labelPaint.textSize *= width * .84f / labelWidth
+            canvas.drawText(label, width / 2f, height / 2f + labelPaint.textSize * .35f, labelPaint)
+        }
+
+        @SuppressLint("ClickableViewAccessibility")
+        override fun onTouchEvent(event: MotionEvent): Boolean {
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> setDown(true)
+                MotionEvent.ACTION_UP -> setDown(false)
+                MotionEvent.ACTION_CANCEL -> setDown(false, cancelled = true)
+            }
+            return true
+        }
+
+        protected open fun setDown(down: Boolean, cancelled: Boolean = false) {
+            if (pressedDown == down) return
+            pressedDown = down
+            if (down) {
+                feedback()
+                onPress()
+            }
+            invalidate()
+        }
+
+        open fun reset() {
+            pressedDown = false
+            invalidate()
+        }
+    }
+
+    // ---------------------------------------------------------------- CLICK button (held while pressed)
+
+    private inner class ClickStripView(context: Context, private val pad: TrackpadView) :
+        HotkeyView(context, "CLICK", {}) {
+        override fun setDown(down: Boolean, cancelled: Boolean) {
+            super.setDown(down, cancelled)
+            pad.stripPress(down)
+        }
+
+        override fun reset() {
+            super.reset()
+            pad.stripPress(false)
+        }
+    }
+
+    private companion object {
+        const val LEFT = 0
+        const val RIGHT = 1
+        const val TYPE_INTERNAL = 1
+        val KNOWN_DUAL_SCREEN_MODELS = setOf("retroid pocket duo", "ayn thor")
+
+        const val PREFS = "second_screen_trackpad"
+        const val PREF_THEME = "accent_theme"
+
+        const val BACK_GUARD_MS = 800L
+        const val PAD_BOTTOM = .78f // pads end here; bottom row below
+        const val EXCLUSION_LIMIT_DP = 200f // Android's per-edge limit outside sticky immersive
+        const val TAP_MS = 180L
+        const val TAP_CLICK_HOLD_MS = 60L
+
+        // OLED care
+        const val DIM_AFTER_MS = 10_000L
+        const val OFF_AFTER_MS = 60_000L
+        const val DIM_ALPHA = 0.25f
+        const val SHIFT_INTERVAL_MS = 60_000L
+        val SHIFT_PATTERN = listOf(0f to 0f, 2f to 1f, -1f to 2f, -2f to -1f, 1f to -2f)
+        const val IDLE_LINE_ALPHA = 0x55
+        const val GUIDE_ALPHA = 0x22
+
+        // Shapes and text (DroidDeck)
+        const val CORNER = 20f
+        const val HOTKEY_CORNER = 12f
+        val TEXT = Color.rgb(0xC8, 0xCC, 0xD2)
+        val TEXT_DIM = Color.rgb(0x5A, 0x60, 0x6A)
+
+        // Accent colours, cycled with the COLOR hotkey (first is DroidDeck's blue)
+        val THEMES = intArrayOf(
+            Color.rgb(0x1A, 0x9F, 0xFF), // blue
+            Color.rgb(0xFF, 0x3B, 0x3B), // red
+            Color.rgb(0x2B, 0xD9, 0x6B), // green
+            Color.rgb(0xA0, 0x6B, 0xFF), // purple
+            Color.rgb(0xFF, 0x8A, 0x1F), // orange
+            Color.rgb(0xFF, 0x4F, 0xA3), // pink
+            Color.rgb(0x2E, 0xE6, 0xE6), // cyan
+            Color.rgb(0xB0, 0xB0, 0xB0), // grey
+        )
+    }
+}
